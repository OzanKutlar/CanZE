<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/motor_root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:background="#00E5FF"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activity_motor"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- V8 COCKPIT & TACHOMETER CLUSTER CARD -->
        <LinearLayout
            android:id="@+id/card_tachometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center_horizontal"
            android:layout_marginBottom="14dp">

            <lu.fisch.canze.widgets.RpmGaugeView
                android:id="@+id/gauge_rpm"
                android:layout_width="240dp"
                android:layout_height="180dp" />

            <!-- 2x2 ACTION CONTROLS DOCK -->
            <!-- Row 1: [ Ignition ]  [ Sound Toggle ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp">

                <Button
                    android:id="@+id/btn_ignition"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="4dp"
                    android:text="🔑 IGNITION: OFF"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="#161F2E" />

                <Button
                    android:id="@+id/btn_sound_toggle"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:text="🔊 SOUND: ON"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="#161F2E" />
            </LinearLayout>

            <!-- Row 2: [ Settings ]  [ Test Drive ] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_settings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:layout_marginRight="4dp"
                    android:text="⚙ SETTINGS"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="#161F2E" />

                <Button
                    android:id="@+id/btn_test_drive"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginLeft="4dp"
                    android:text="▶ TEST DRIVE"
                    android:textColor="#FFD600"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="#161F2E" />
            </LinearLayout>
        </LinearLayout>

        <!-- SPEED CARD (HERO) -->
        <LinearLayout
            android:id="@+id/card_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VEHICLE SPEED"
                android:textColor="#8A99AD"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_speed_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#00E5FF"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_speed_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="km/h"
                    android:textColor="#00E5FF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_speed"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="150"
                android:progress="0"
                android:progressDrawable="@drawable/motor_progress_speed" />
        </LinearLayout>

        <!-- PEDAL POSITION CARD -->
        <LinearLayout
            android:id="@+id/card_pedal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:text="ACCELERATOR PEDAL"
                    android:textColor="#8A99AD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_pedal_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:text="0 %"
                    android:textColor="#00E676"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/pb_pedal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/motor_progress_pedal" />
        </LinearLayout>

        <!-- MOTOR TORQUE CARD -->
        <LinearLayout
            android:id="@+id/card_torque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:text="MOTOR TORQUE"
                    android:textColor="#8A99AD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <TextView
                    android:id="@+id/tv_torque_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:text="0 Nm"
                    android:textColor="#E040FB"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <ProgressBar
                android:id="@+id/pb_torque"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="250"
                android:progress="0"
                android:progressDrawable="@drawable/motor_progress_torque" />
        </LinearLayout>

        <!-- SIMULATOR CONTROLS (VISIBLE WHEN DISCONNECTED) -->
        <LinearLayout
            android:id="@+id/card_simulator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#FFD600"
                    android:layout_marginEnd="8dp"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SIMULATOR CONTROLS (DISCONNECTED)"
                    android:textColor="#FFD600"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Simulator Speed Slider -->
            <TextView
                android:id="@+id/tv_sim_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulated Speed: 0 km/h"
                android:textColor="#8A99AD"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sb_sim_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="160"
                android:progress="0"
                android:layout_marginBottom="12dp" />

            <!-- Simulator Pedal Slider -->
            <TextView
                android:id="@+id/tv_sim_pedal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulated Pedal: 0 %"
                android:textColor="#8A99AD"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sb_sim_pedal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:layout_marginBottom="12dp" />

            <!-- Simulator Torque Slider (-150 Nm to +250 Nm) -->
            <TextView
                android:id="@+id/tv_sim_torque_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simulated Torque: 0 Nm (Idle/Coast)"
                android:textColor="#8A99AD"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/sb_sim_torque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="400"
                android:progress="150" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
