<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true"
    android:keepScreenOn="true"
    tools:context="lu.fisch.canze.activities.BatteryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#00E5FF"
                android:layout_marginEnd="8dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_activity_battery"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● TRACTION BATTERY"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- HERO ROW: AVAILABLE RANGE & AVAILABLE KW -->
        <LinearLayout
            android:id="@+id/card_hero_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Available Range -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_motor_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_DISTA"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/spinnerRange"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:indeterminate="true" />

                    <LinearLayout
                        android:id="@+id/containerRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textRange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_Dash"
                            android:textColor="#FFD600"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/textRangeUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="km"
                            android:textColor="#FFD600"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>

            <!-- Available Energy / kW -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_motor_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_AvEner"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/spinnerEnergy"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:indeterminate="true" />

                    <LinearLayout
                        android:id="@+id/containerEnergy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textEnergy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_Dash"
                            android:textColor="#00E5FF"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:id="@+id/textEnergyUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="kWh"
                            android:textColor="#00E5FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- INDICATOR 1 & 2: SOH AND REAL VS INDICATED SOC DELTA -->
        <LinearLayout
            android:id="@+id/card_soh_delta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Indicator 1: State of Health (SOH) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_motor_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginEnd="6dp"
                android:layout_marginRight="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_SOH"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/spinnerSOH"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:indeterminate="true" />

                    <LinearLayout
                        android:id="@+id/containerSOH"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textSOHVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_Dash"
                            android:textColor="#00E676"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="%"
                            android:textColor="#00E676"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/textSOHSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#607D8B"
                    android:textSize="11sp"
                    android:text="State of Health" />
            </LinearLayout>

            <!-- Indicator 2: Real vs Indicated Delta -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_motor_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginStart="6dp"
                android:layout_marginLeft="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL VS INDICATED"
                    android:textColor="#8A99AD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ProgressBar
                        android:id="@+id/spinnerSocDelta"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_centerVertical="true"
                        android:indeterminate="true" />

                    <LinearLayout
                        android:id="@+id/containerSocDelta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textSocDelta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_Dash"
                            android:textColor="#00E5FF"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginBottom="4dp"
                            android:text="%"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/textSocDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#607D8B"
                    android:textSize="11sp"
                    android:text="Average delta" />
            </LinearLayout>
        </LinearLayout>

        <!-- INDICATOR 3: CELL VOLTAGES (MIN, MAX, DIFFERENCE) -->
        <LinearLayout
            android:id="@+id/card_cell_voltages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CELL VOLTAGES"
                    android:textColor="#8A99AD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <ProgressBar
                    android:id="@+id/spinnerVoltages"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerVoltages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">

                <!-- Min Voltage -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MIN VOLTAGE"
                        android:textColor="#607D8B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCellMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/default_Dash"
                        android:textColor="#00E5FF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="V"
                        android:textColor="#8A99AD"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="#1F293D" />

                <!-- Max Voltage -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAX VOLTAGE"
                        android:textColor="#607D8B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCellMax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/default_Dash"
                        android:textColor="#00E676"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="V"
                        android:textColor="#8A99AD"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:background="#1F293D" />

                <!-- Delta Difference -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIFFERENCE (Δ)"
                        android:textColor="#607D8B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textCellDiff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/default_Dash"
                        android:textColor="#FFD600"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="mV"
                        android:textColor="#8A99AD"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- INDICATOR 4: BATTERY MODULE TEMPERATURE HEATMAP -->
        <LinearLayout
            android:id="@+id/card_heatmap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_motor_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MODULE TEMPERATURES HEATMAP"
                    android:textColor="#8A99AD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

                <ProgressBar
                    android:id="@+id/spinnerHeatmap"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerHeatmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 4 PRIMARY MODULE BOXES (Heatmap for 4 compartments / first 4) -->
                <GridLayout
                    android:id="@+id/gridHeatmapPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:alignmentMode="alignMargins">

                    <!-- Box 1 -->
                    <LinearLayout
                        android:id="@+id/boxTemp1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOD 1"
                            android:textColor="#8A99AD"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textModTemp1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Box 2 -->
                    <LinearLayout
                        android:id="@+id/boxTemp2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOD 2"
                            android:textColor="#8A99AD"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textModTemp2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Box 3 -->
                    <LinearLayout
                        android:id="@+id/boxTemp3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOD 3"
                            android:textColor="#8A99AD"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textModTemp3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Box 4 -->
                    <LinearLayout
                        android:id="@+id/boxTemp4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOD 4"
                            android:textColor="#8A99AD"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/textModTemp4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </GridLayout>

                <!-- ADDITIONAL EXTENDED MODULES FOR 12-MODULE BATTERIES (ZOE) -->
                <GridLayout
                    android:id="@+id/gridHeatmapExtended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:layout_marginTop="4dp"
                    android:alignmentMode="alignMargins"
                    android:visibility="gone">

                    <!-- Modules 5 to 12 -->
                    <!-- Box 5 -->
                    <LinearLayout
                        android:id="@+id/boxTemp5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M5" android:textColor="#8A99AD" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/textModTemp5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <!-- Box 6 -->
                    <LinearLayout
                        android:id="@+id/boxTemp6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M6" android:textColor="#8A99AD" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/textModTemp6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <!-- Box 7 -->
                    <LinearLayout
                        android:id="@+id/boxTemp7"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M7" android:textColor="#8A99AD" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/textModTemp7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <!-- Box 8 -->
                    <LinearLayout
                        android:id="@+id/boxTemp8"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M8" android:textColor="#8A99AD" android:textSize="9sp" android:textStyle="bold" />
                        <TextView android:id="@+id/textModTemp8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>
                    <!-- Box 9 -->
                    <LinearLayout
                        android:id="@+id/boxTemp9"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="3dp"
                        android:background="#1A2436"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M9" android:textColor="#8A99AD" android:textSize="9sp" android:textStyle="bold" />
