<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:keepScreenOn="true">

    <!-- Speed and SoC column plus a slot holding either the gear band or the media player.
         Orientation and weights are set by HudMediaPanel. -->
    <LinearLayout
        android:id="@+id/hudRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/hudBands"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="vertical">

            <!-- Speed -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/hudSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/hud_no_value"
                    android:textColor="#4A5B73"
                    android:textSize="96sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hudSpeedUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:textColor="#607D8B"
                    android:textSize="16sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A2436" />

            <!-- State of charge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/hudSoc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/hud_no_value"
                    android:textColor="#4A5B73"
                    android:textSize="96sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:text="@string/hud_label_soc"
                    android:textColor="#607D8B"
                    android:textSize="16sp" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/hudSlotDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A2436" />

        <FrameLayout
            android:id="@+id/hudSlot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Gear -->
            <FrameLayout
                android:id="@+id/hudGearBand"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/hudGear"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/hud_no_value"
                    android:textColor="#4A5B73"
                    android:textSize="96sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:text="@string/hud_label_gear"
                    android:textColor="#607D8B"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/hudMediaChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/hud_media_chip_bg"
                    android:clickable="true"
                    android:contentDescription="@string/hud_media_enable_chip_description"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/hud_media_enable_chip"
                    android:textColor="#00E676"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Media player: takes the gear band's place while a player session exists -->
            <FrameLayout
                android:id="@+id/hudMediaPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <lu.fisch.canze.widgets.CoverAmbienceView
                    android:id="@+id/hudMediaAmbience"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:paddingLeft="12dp"
                        android:paddingTop="12dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="4dp">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.42">

                            <lu.fisch.canze.widgets.VinylDiscView
                                android:id="@+id/hudMediaVinyl"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_gravity="center"
                                android:clickable="true"
                                android:contentDescription="@string/hud_media_cover"
                                android:focusable="true" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginLeft="14dp"
                            android:layout_weight="0.58"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/hudMediaSource"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="#B0BEC5"
                                android:textSize="12sp" />

                            <lu.fisch.canze.widgets.MarqueeTextView
                                android:id="@+id/hudMediaTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hudMediaArtist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="#CFD8DC"
                                android:textSize="16sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/hudMediaElapsed"
                                    android:layout_width="56dp"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:textColor="#CFD8DC"
                                    android:textSize="13sp" />

                                <SeekBar
                                    android:id="@+id/hudMediaSeek"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:contentDescription="@string/hud_media_seek"
                                    android:maxHeight="6dp"
                                    android:minHeight="6dp"
                                    android:paddingLeft="14dp"
                                    android:paddingRight="14dp"
                                    android:progressDrawable="@drawable/hud_media_seek_progress"
                                    android:thumb="@drawable/hud_media_seek_thumb" />

                                <TextView
                                    android:id="@+id/hudMediaDuration"
                                    android:layout_width="56dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:textColor="#CFD8DC"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Driving-sized controls: every cell is a full touch target -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:paddingBottom="4dp">

                        <FrameLayout
                            android:id="@+id/hudMediaShuffle"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/hud_media_cell_bg"
                            android:clickable="true"
                            android:contentDescription="@string/hud_media_shuffle"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/hudMediaShuffleIcon"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/hud_ic_shuffle" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/hudMediaPrevious"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/hud_media_cell_bg"
                            android:clickable="true"
                            android:contentDescription="@string/hud_media_previous"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/hud_ic_previous"
                                android:tint="#ECEFF1" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/hudMediaPlay"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/hud_media_cell_bg"
                            android:clickable="true"
                            android:contentDescription="@string/hud_media_play"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/hudMediaPlayIcon"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:layout_gravity="center"
                                android:background="@drawable/hud_media_play_bg"
                                android:contentDescription="@null"
                                android:padding="16dp"
                                android:src="@drawable/hud_ic_play"
                                android:tint="#0B0F19" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/hudMediaNext"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/hud_media_cell_bg"
                            android:clickable="true"
                            android:contentDescription="@string/hud_media_next"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/hud_ic_next"
                                android:tint="#ECEFF1" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <Button
        android:id="@+id/hudDemoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/hud_demo_start"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hudDemoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#2A3326"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="6dp"
        android:text="@string/hud_demo_badge"
        android:textColor="#FFD600"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textDebug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:textColor="#607D8B"
        android:textSize="10sp" />

</FrameLayout>
