<?xml version="1.0" encoding="utf-8"?>
<!-- Reconnect overlay, added on top of every CanzeActivity screen.
     clickable/focusable so touches do not reach the (stale) screen underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reconnect_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="#F2263238"
        android:gravity="center_horizontal"
        android:minWidth="260dp"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/reconnect_icon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/animation_bluetooth"
            android:contentDescription="@string/reconnect_title" />

        <ProgressBar
            android:id="@+id/reconnect_spinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/reconnect_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/reconnect_title"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/reconnect_attempt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/reconnect_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/reconnect_back" />
    </LinearLayout>
</FrameLayout>
